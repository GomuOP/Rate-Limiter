{
  "mode": "local",

  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "backlog": 1024,
    "max_header_bytes": 8192,
    "max_body_bytes": 65536,
    "idle_timeout_ms": 15000
  },

  "limiter": {
    "algo": "token_bucket",
    "rate": 100.0,
    "burst": 200,

    "limit": 100,
    "window_ms": 1000
  },

  "key_store": {
    "max_keys": 100000,
    "idle_ttl_ms": 600000,
    "sweep_interval_ms": 5000
  },

  "key_extractor": {
    "source": "query",
    "param": "key",
    "trust_forwarded_for": false,
    "fallback_ip": true
  },

  "redis": {
    "host": "127.0.0.1",
    "port": 6379,
    "timeout_ms": 50,
    "fail_closed": false,
    "connect_backoff_ms": 500
  }
}
